# =============================================================================
# config.example.env - copy to config.env and fill in your values:
#     cp config.example.env config.env
# config.env is git-ignored, so your domain/email never end up in the repo.
# =============================================================================

# Your domain. A PUBLIC Route 53 hosted zone for it must already exist, and the
# domain's registrar must use that zone's 4 name servers.
DOMAIN="example.com"

# WordPress admin account. The password is generated automatically and stored
# encrypted in SSM Parameter Store at /<PROJECT>/wp/admin-password.
# The email is also used for Let's Encrypt expiry notices when you use --https.
WP_ADMIN_EMAIL="you@example.com"
WP_ADMIN_USER="siteadmin"          # avoid "admin" - it is the first name bots try
WP_TITLE="My WordPress Site"

# Name prefix + value of the Project=... tag on every resource (lowercase,
# digits, '-'). Change it to run several independent sites in one account.
PROJECT="wordpress-site"

# Region for all regional resources.
AWS_REGION="us-east-1"
